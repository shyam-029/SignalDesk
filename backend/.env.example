# SignalDesk backend environment template.
#
# Copy this file to `.env` (it is git-ignored; never commit it) and fill in
# real values. A blank value counts as "not set". Names not listed here are
# ignored. Production does not read this file: set the same names in the
# Render service environment, then redeploy.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# development | production
APP_ENV=development

# Postgres (asyncpg driver): postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/signaldesk

# Browser origins allowed to call the API, comma separated.
# Production needs your real site (for example https://<project>.pages.dev);
# "*" is refused in production.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# AI assistant (the Ask box and score explanations)
# ---------------------------------------------------------------------------
# Needs OPENROUTER_API_KEY and LLM_MODEL. If either is missing, wrong or out of
# quota the site keeps working: it answers from stored data instead of the AI.
# If answers look identical for every question, the AI is not running.
# Check the server log for a line starting "ask_" that gives the reason.

# Your OpenRouter key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# "openrouter/free" lets OpenRouter pick a working free model on every request,
# so nothing breaks when a model is retired. To pin one model instead, copy its
# exact id from https://openrouter.ai/models (free ones end in ":free").
LLM_MODEL=openrouter/free

# Most AI calls per server process per day. OpenRouter's free tier allows about
# 50 a day; after that every answer falls back to stored data until tomorrow.
LLM_DAILY_CAP=50

# Optional, rarely needed:
# LLM_BASE_URL=https://openrouter.ai/api/v1    (must be https in production)
# LLM_MAX_CONCURRENT=3                         (simultaneous AI calls)
# LLM_API_KEY=                                 (same as OPENROUTER_API_KEY, set one of them)
# Also turn on OpenRouter's prompt-injection guardrail in its dashboard.

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# Upstox "Analytics Token" (read-only market data, server side only). Leave blank
# to run on Yahoo Finance only. The token expires and must be regenerated.
UPSTOX_ANALYTICS_TOKEN=

# ---------------------------------------------------------------------------
# Operations (required in production)
# ---------------------------------------------------------------------------
# Password for the private status and job-history endpoints. Without it, those
# endpoints are switched off (404) in production. Use 40+ random characters.
# OPS_API_KEY=
# Optional separate key for cron triggers; blank means "use OPS_API_KEY".
# CRON_API_KEY=

# ---------------------------------------------------------------------------
# Rate limits (per visitor, per minute). Defaults shown; change only if needed.
# ---------------------------------------------------------------------------
# RATE_LIMIT_LLM_PER_MIN=20
# RATE_LIMIT_EXPENSIVE_PER_MIN=60
# RATE_LIMIT_DEFAULT_PER_MIN=300

# ---------------------------------------------------------------------------
# Production checklist (Render environment variables)
# ---------------------------------------------------------------------------
# APP_ENV=production
# DATABASE_URL=postgresql+asyncpg://...neon.tech/neondb?ssl=require
# CORS_ORIGINS=https://<project>.pages.dev
# OPS_API_KEY=<40+ random characters>
# OPENROUTER_API_KEY, LLM_MODEL, LLM_DAILY_CAP (see the AI section above)
# Cloudflare Pages holds one non-secret build variable: VITE_API_BASE.
# GitHub Actions secrets: DATABASE_URL, OPS_API_KEY.
