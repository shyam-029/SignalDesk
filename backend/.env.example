# SignalDesk environment template.
# Copy to `.env` and fill in real values. `.env` is git-ignored (never commit it).

# Application environment: development | production
APP_ENV=development

# PostgreSQL connection string (asyncpg driver).
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/signaldesk

# Redis (deferred to P1 caching phase) — leave empty for now.
REDIS_URL=

# LLM API key (deferred to later phase) — leave empty for now.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...

# --- LLM provider (Phase 5: grounded explanation narrative) ---
# OpenRouter API key + model. Free models change availability/rate limits:
# verify the model is still served before use. If the key is empty OR the
# model/key fails, the app falls back to the rule-based explanation.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Example only — replace with a currently-available (ideally free) model ID.
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Max LLM calls per process-day (in-process cap; Redis deferred).
LLM_DAILY_CAP=100

# Optional: Finnhub live-prices API key (deferred) — leave empty for now.
# FINNHUB_API_KEY=