# SignalDesk environment template.
# Copy to `.env` and fill in real values. `.env` is git-ignored (never commit it).

# Application environment: development | production
APP_ENV=development

# PostgreSQL connection string (asyncpg driver).
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/signaldesk

# Redis (deferred to P1 caching phase) — leave empty for now.
REDIS_URL=

# LLM API key (deferred to later phase) — leave empty for now.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...

# --- LLM provider (Phase 5 narrative + Part H grounded ask) ---
# OpenRouter API key + model. Free models change availability/rate limits:
# the model is verified against the OpenRouter catalog before the first
# request. If the key is empty OR the model/key fails, the app falls back to
# the rule-based explanation.
# LLM_API_KEY is the primary variable; OPENROUTER_API_KEY (below) is accepted
# as an alias when LLM_API_KEY is not set.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Example only — replace with a currently-available (ideally free) model ID.
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Max LLM calls per process-day (in-process cap; Redis deferred).
LLM_DAILY_CAP=100

# Optional: Finnhub live-prices API key (deferred) — leave empty for now.
# FINNHUB_API_KEY=

# --- Upstox market data (dual providers) ---
# Manually generated Upstox access token (developer dashboard, "Generate")
# used as a Bearer credential for read-only market-data APIs. Leave empty to
# run yfinance-only. Server-side only: never logged, never sent to browsers,
# never committed.
UPSTOX_ANALYTICS_TOKEN=

# --- OpenRouter (alternative name for the LLM gateway key) ---
# Recognized as an alias for LLM_API_KEY (used when LLM_API_KEY is empty).
# Also: enable OpenRouter's workspace prompt-injection guardrail in the
# OpenRouter dashboard — it is an additional provider-side security layer for
# all LLM requests; the app additionally treats user input as untrusted.
OPENROUTER_API_KEY=

# --- CORS (Phase 6: browser frontend) ---
# Comma-separated origins allowed to call the API from a browser.
# Defaults to the Vite dev server. Add production origins here, e.g.
# CORS_ORIGINS=https://signaldesk.example.com,https://www.signaldesk.example.com
CORS_ORIGINS=http://localhost:5173