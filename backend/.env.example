# SignalDesk environment template.
# Copy to `.env` and fill in real values. `.env` is git-ignored (never commit it).

# Application environment: development | production
APP_ENV=development

# PostgreSQL connection string (asyncpg driver).
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/signaldesk

# Redis (deferred to P1 caching phase) — leave empty for now.
REDIS_URL=

# LLM API key (deferred to later phase) — leave empty for now.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...

# Optional: Finnhub live-prices API key (deferred) — leave empty for now.
# FINNHUB_API_KEY=